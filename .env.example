# --- required ---
# New bot from https://discord.com/developers/applications (enable Message Content Intent)
DISCORD_TOKEN=
# Your Discord user id (Developer Mode → right-click yourself → Copy User ID)
OWNER_ID=
# Private channel the bot listens in; each message there becomes a task thread
HOME_CHANNEL_ID=

# --- Claude auth ---
# Recommended: a Console API key (https://platform.claude.com) billed to the company.
# Empty = falls back to the Claude Code login on this Mac.
ANTHROPIC_API_KEY=

# --- optional (defaults shown) ---
# REPOS_ROOT=/Users/user/rifle
# WORKTREES_ROOT=/Users/user/rifle/_bot_worktrees
# MODEL=
# MAX_BUDGET_USD_PER_RUN=5
# MAX_TURNS_PER_RUN=150
# MAX_CONCURRENT_RUNS=3
# APPROVAL_TIMEOUT_MIN=360
